# Business Event Management System - Environment Configuration Example
# Copy values to config/config.php and customize for your environment

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=business_event_system

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
APP_NAME=Business Event Management System
APP_VERSION=1.0.0
APP_ENV=production
APP_DEBUG=false

# ==========================================
# BASE URLS
# ==========================================
BASE_URL=http://localhost/BusinessEventManagementSystem/
API_URL=http://localhost/BusinessEventManagementSystem/api/

# ==========================================
# SECURITY CONFIGURATION
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=86400
PASSWORD_HASH_ALGO=PASSWORD_BCRYPT

# ==========================================
# SESSION CONFIGURATION
# ==========================================
SESSION_TIMEOUT=3600
REMEMBER_ME_DURATION=604800

# ==========================================
# FILE UPLOAD CONFIGURATION
# ==========================================
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=/storage/uploads/
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# ==========================================
# PAGINATION
# ==========================================
ITEMS_PER_PAGE=20

# ==========================================
# NOTES FOR PRODUCTION
# ==========================================
# 1. Change JWT_SECRET to a strong random value
# 2. Set APP_ENV to 'production'
# 3. Set APP_DEBUG to false
# 4. Use strong database password
# 5. Implement HTTPS (not HTTP)
# 6. Keep database credentials secure
# 7. Regular security updates
# 8. Backup database regularly
